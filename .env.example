# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/genetigz

# Long, random, secret string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session stays valid before the JWT expires.
JWT_EXPIRES_IN=30d

# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
# (your live site domain + local dev URLs, e.g. http://127.0.0.1:5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# One-time bootstrap: set to "true" temporarily to allow POST
# /api/auth/register to create an isAdmin:true account, then set back
# to "false" (or remove) once your first admin exists.
ALLOW_ADMIN_SELF_SIGNUP=false
