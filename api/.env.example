MONGO_URI=mongodb://127.0.0.1:27017/genetigz
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Set this to whatever actually serves your frontend HTML files.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Leave false in production. Only set to true temporarily to create
# your first admin account via POST /api/auth/register with isAdmin:true,
# then flip it back to false.
ALLOW_ADMIN_SELF_SIGNUP=false
